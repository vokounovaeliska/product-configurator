# Backend Environment Variables
# Copy this file to .env and adjust values as needed

# Database Connection
DB_URL=jdbc:postgresql://localhost:5432/configuratordb
DB_USERNAME=configuratoruser
DB_PASSWORD=configuratorpassword

# JWT Configuration (optional - has default value)
JWT_USERS_KEY=your-secret-jwt-key-here

# Spring Profile (optional - defaults to dev)
SPRING_PROFILES_ACTIVE=dev
