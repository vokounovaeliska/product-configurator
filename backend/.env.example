# Backend Environment Variables
# Copy this file to .env and adjust values as needed

# Database Connection
DB_URL=jdbc:postgresql://localhost:5432/configuratordb
DB_USERNAME=configuratoruser
DB_PASSWORD=configuratorpassword

# JWT Configuration (optional - has default value)
JWT_USERS_KEY=your-secret-jwt-key-here

# Spring Profile (optional - defaults to dev)
SPRING_PROFILES_ACTIVE=dev

# Email – choose one:
# Option A: Resend (recommended for Railway – works on Free/Hobby, uses HTTPS)
RESEND_API_KEY=re_xxxxxxxxx

# Option B: SMTP (blocked on Railway Free/Hobby; use Resend instead)
# When neither is set, emails are logged only (noop).
SPRING_MAIL_HOST=mail.webglobe.cz
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=info@konfiguruj.com
SPRING_MAIL_PASSWORD=your-mailbox-password
MAIL_FROM=noreply@konfiguruj.com
MAIL_FROM_NAME=Konfiguruj
