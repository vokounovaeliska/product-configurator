# Backend specific gitignore

# Environment files (keep .env.example)
.env
.env.*
!.env.example

# Maven - ignore target but keep jOOQ generated sources
target/*
!target/generated-sources/
target/generated-sources/*
!target/generated-sources/jooq/
!target/generated-sources/jooq/**
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

user_stories_asana.json

/uploads/

.cursorrules
.cursor/*
