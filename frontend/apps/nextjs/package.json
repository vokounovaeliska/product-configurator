{
  "name": "nextjs",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "format:check": "prettier --check './src/**/*.{ts,tsx,css,js,cjs,mjs,json}'",
    "format:fix": "prettier --write './src/**/*.{ts,tsx,css,js,cjs,mjs,json}'",
    "lint:check": "eslint './src/**/*.{ts,tsx,js,cjs,mjs}'",
    "lint:fix": "eslint --fix './src/**/*.{ts,tsx,js,cjs,mjs}'",
    "type-check": "tsc --noEmit",
    "generate:api": "openapi-typescript \"${NEXT_PUBLIC_BE_URL:-http://localhost:8080}/swagger/api-docs\" -o src/api/types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.0.1",
    "@t3-oss/env-nextjs": "^0.13.4",
    "@tanstack/react-query": "5.76.0",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.2.8",
    "ky": "1.8.1",
    "lucide-react": "^0.510.0",
    "next": "^15.3.2",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.56.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@next/eslint-plugin-next": "^15.3.2",
    "@storybook/react": "^8.6.12",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@tanstack/react-query-devtools": "5.76.0",
    "@types/node": "^22.15.17",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitest/eslint-plugin": "^1.1.44",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.26.0",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-import": ">=2.31",
    "eslint-plugin-jsx-a11y": ">=6.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.3",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-sort-json": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.1.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "openapi-typescript": "^7.4.4"
  }
}
